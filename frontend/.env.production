# Used by `vite build` (Vercel). The API is reached through the Vercel rewrite
# in vercel.json (/api/* → the Render service), so the browser only ever talks
# to the Vercel domain and the session cookies stay first-party.
VITE_APP_NAME=Project Camp
VITE_API_BASE_URL=/api/v1
VITE_OAUTH_ENABLED=false
# "Try the live demo" on the landing page, and the demo-account prefill on
# /login?demo=1. Keep false unless the demo team is seeded (docs/DEPLOY.md, step 4);
# a Vercel environment variable VITE_DEMO_LOGIN=true overrides this at build time.
VITE_DEMO_LOGIN=false
