# Vite mode used only by the Playwright suite (`vite --mode e2e`).
# A mode-specific file takes precedence over .env, so this pins E2E runs to the
# ephemeral in-memory API on :8123 and can never reach a real backend on :8000.
VITE_APP_NAME=Project Camp (E2E)
VITE_API_BASE_URL=http://localhost:8123/api/v1
# OAuth providers are not configured on the ephemeral API.
VITE_OAUTH_ENABLED=false
