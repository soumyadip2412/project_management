# Database Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/projmanage?retryWrites=true&w=majority

# Server Port & CORS
PORT=8000
CORS_ORIGIN=http://localhost:5173

# JWT Tokens — the two secrets MUST differ (with one shared secret a refresh
# token also verifies as an access token). Production requires >= 32 chars:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=your_access_token_secret_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=a_different_refresh_token_secret_here
REFRESH_TOKEN_EXPIRY=7d

# Number of reverse-proxy hops in front of the API (load balancer = 1).
# Needed for correct client IPs in rate limiting; leave unset locally.
# TRUST_PROXY=1

# Optional: share rate-limit counters across multiple API instances.
# REDIS_URL=redis://localhost:6379

# Optional: error | warn | info | debug (default info)
# LOG_LEVEL=info

# Mail SMTP Credentials (Mailtrap / SendGrid)
MAIL_TRAP_HOST=sandbox.smtp.mailtrap.io
MAIL_TRAP_PORT=2525
MAIL_TRAP_USER=your_mailtrap_user
MAIL_TRAP_PASS=your_mailtrap_pass

# Password Reset Redirect URL
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:5173/auth/reset-password

# Email Verification Redirect URL (frontend page; the token is appended)
EMAIL_VERIFICATION_REDIRECT_URL=http://localhost:5173/auth/verify-email

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

